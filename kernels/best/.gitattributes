# Preserve benchmark source hashes across Windows and Linux checkouts.
.gitattributes text eol=lf
c4/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
c8/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
c8_r2/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
c10/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
fp8/c10/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
